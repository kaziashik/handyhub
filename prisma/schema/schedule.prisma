model Schedule {
    id String @id @default(uuid())

    startDateTime DateTime 
    endDateTime DateTime

     totalSlots     Int
  availableSlots Int
  meetingLink    String

  status ScheduleStatus @default(DRAFT)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  techinicianId String
   techinician   Techinician @relation(fields: [techinicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  appointments Apppointment[]

  @@unique([techinicianId, startDateTime, endDateTime], name: "unique_schedule")
  @@map("schedules")
}